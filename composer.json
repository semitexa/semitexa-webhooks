{
    "name": "semitexa/webhooks",
    "description": "Semitexa Webhooks - inbound verification/deduplication and outbound durable delivery with retries",
    "type": "semitexa-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Semitexa",
            "email": "support@semitexa.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "semitexa/core": ">=2026.10.29.1052 || dev-master",
        "semitexa/orm": ">=2026.10.29.1052 || dev-master"
    },
    "require-dev": {
        "semitexa/testing": "*"
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\Webhooks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\Webhooks\\Tests\\": "tests/"
        }
    },
    "extra": {
        "semitexa-module": {
            "extends": null
        },
        "semitexa": {
            "floors": {
                "semitexa/orm": "2026.10.29.1052",
                "semitexa/core": "2026.10.29.1052"
            }
        }
    },
    "keywords": [
        "semitexa",
        "webhooks",
        "inbound",
        "outbound",
        "signature-verification"
    ]
}
